# GitNexus index exclusions (FASE 36B+)
# Goal: keep structural truth clean; avoid operational/runtime data and build artifacts.

# Git / environments
.git/
.venv/
venv/
__pycache__/
*.pyc

# Node / build outputs
node_modules/
dist/

# Runtime source files (override .gitignore restrictions for indexing)
# .gitignore has runtime/ + !runtime/ + runtime/* which blocks descent into
# most runtime subdirectories. We unignore ALL runtime/ files here, then
# re-exclude operational/data subdirectories.
!runtime/**
runtime/**/.pytest_cache/**
runtime/**/__pycache__/**
runtime/**/*.pyc
runtime/**/*.log

# Runtime operational data (never index)
runtime/state/**

# Common temp/log/data folders
tmp/
logs/
data/


# Astro docs build artifacts
apps/ialab-docs/dist/
apps/ialab-docs/node_modules/
