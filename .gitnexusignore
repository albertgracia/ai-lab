# GitNexus index exclusions (FASE 36B+) — REINDEX FIX 01
# Goal: keep structural truth clean; avoid operational/runtime data and build artifacts.

# Git / environments
.git/
.venv/
venv/
__pycache__/
*.pyc

# Node / build outputs
node_modules/
dist/

# ── Runtime source files ──────────────────────────────────────────────
# .gitignore has runtime/ + !runtime/ + runtime/* which blocks descent into
# most runtime subdirectories. We override with fine-grained includes.

# Include ALL runtime source directories
!runtime/**
!runtime/gateway/
!runtime/gateway/*.py

# Explicit includes for files excluded by .gitignore selective un-ignore
!runtime/gateway/openai_gateway.py
!runtime/gateway/tool_request_classifier.py
!runtime/gateway/runtime_api_routes.py
!runtime/gateway/stream_sanitizer.py
!runtime/gateway/tool_call_parser.py
!runtime/gateway/process_guard.py

# Exclude runtime operational / generated data
runtime/**/.pytest_cache/**
runtime/**/__pycache__/**
runtime/**/*.pyc
runtime/**/*.log
runtime/state/**

# Exclude backup and temp files
*.bak
*.bak.*
*.backup
*.backup.*
*.cp*bak*
**/*.bak
**/*.bak.*
**/*.backup
**/*.backup.*
**/*.cp*bak*
tests/*.bak*
runtime/**/*.bak*
runtime/**/*.backup*

# ── Reports ───────────────────────────────────────────────────────────
reports/
!reports/*.md

# ── Common temp/log/data folders ─────────────────────────────────────
tmp/
logs/
data/

# ── Astro docs build artifacts ───────────────────────────────────────
apps/ialab-docs/dist/
apps/ialab-docs/node_modules/
