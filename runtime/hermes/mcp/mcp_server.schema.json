{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP Server — Hermes Enterprise MCP Registry",
  "description": "Schema for individual MCP server YAML files in runtime/hermes/mcp/",
  "type": "object",
  "version": "1.0.0",
  "required": [
    "id", "name", "description", "version",
    "protocol", "tools", "status"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Unique MCP server identifier" },
    "name": { "type": "string", "minLength": 1, "description": "Human-readable name" },
    "description": { "type": "string", "minLength": 1, "description": "One-line purpose" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },

    "protocol": {
      "type": "string",
      "enum": ["stdio", "url", "gitnexus"],
      "description": "Connection protocol"
    },
    "url": {
      "type": "string",
      "description": "Endpoint URL (required when protocol=url)"
    },

    "auth": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["token", "none", "key"] },
        "token_var": { "type": "string", "description": "Env variable name for token" }
      },
      "required": ["type"]
    },

    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "read_only"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "read_only": { "type": "boolean" }
        }
      },
      "description": "Tools this MCP server exposes"
    },

    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Higher = preferred when multiple servers can fulfill a request"
    },

    "health_check": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string" },
        "interval_seconds": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "expected_status": { "type": "integer", "minimum": 100, "maximum": 599 }
      }
    },

    "fallback": {
      "type": ["string", "null"],
      "description": "Server ID to use if this server is unavailable"
    },

    "status": {
      "type": "string",
      "enum": ["active", "degraded", "planned", "deprecated"],
      "description": "Operational status of this MCP server"
    },

    "domains": {
      "type": "array",
      "items": { "type": "string", "enum": ["ai-lab", "marketplace", "observability", "gitnexus", "windows"] },
      "description": "SOUL domains this server provides data for"
    }
  }
}
