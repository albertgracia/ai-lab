---
import Layout from '../../layouts/Layout.astro';
import MetricBadge from '../../components/visual/MetricBadge.astro';
import RoadmapBlock from '../../components/visual/RoadmapBlock.astro';
import VisualCard from '../../components/visual/VisualCard.astro';
import VisualSection from '../../components/visual/VisualSection.astro';

const healthMetrics = [
  { label: 'Salud del runtime', value: 'ailab_cognitive_health_score' },
  { label: 'Cross-check de infraestructura', value: 'ai_lab:runtime_health_score' },
  { label: 'Deriva de salud', value: 'Grafana' },
  { label: 'Nodos de inferencia', value: 'no_nodes_online' },
];

const benchmarkCards = [
  {
    title: 'Baseline Gateway',
    kicker: 'Benchmark LM Studio',
    note: '10.40 tps con rango 10.03 / 10.78 tps en la l?nea base.',
    bullets: ['Referencia end-to-end estable.', 'La UI interna de LM Studio no es comparable con el API.'],
  },
  {
    title: 'Streaming vs non-streaming',
    kicker: 'Benchmark LM Studio',
    note: '6.19 tps en la muestra no stream y 4.20 tps estimados en streaming.',
    bullets: ['TTFB medio de 28.401s en la muestra streaming.', 'Se conserva como referencia operativa.'],
  },
  {
    title: 'Router Gemma',
    kicker: 'Benchmark LM Studio',
    note: '11.17 tps en la muestra con ruta expl?cita.',
    codes: ['google/gemma-4-e4b'],
    bullets: ['La ruta expl?cita se preserva en Router.', 'El Gateway puede no preservar siempre el modelo pedido.'],
  },
  {
    title: 'Router sample',
    kicker: 'Benchmark LM Studio',
    note: '2.79 tps como muestra base del Router.',
    bullets: ['Sirve como referencia de policy.', 'No mezclar con valores de la UI de LM Studio.'],
  },
];

const routerCards = [
  {
    title: 'Ruta can?nica',
    kicker: 'Router Auto',
    note: 'La policy de `ailab-router/auto` resuelve por defecto a la ruta codificadora can?nica.',
    codes: ['qwen/qwen2.5-coder-14b-instruct'],
  },
  {
    title: 'Ranking real',
    kicker: 'Router Auto',
    note: 'La selecci?n prioriza capability, performance y health antes de elegir nodo.',
  },
  {
    title: 'Preservaci?n Gemma',
    kicker: 'Router Auto',
    note: 'Si se solicita expl?citamente, la ruta conserva el modelo solicitado.',
    codes: ['google/gemma-4-e4b'],
  },
  {
    title: 'Selector de capability',
    kicker: 'Router Auto',
    note: '`router_api` usa `capability_from_model()` solo para rutas fast, reasoning y coding.',
  },
  {
    title: 'Streaming y non-streaming',
    kicker: 'Router Auto',
    note: 'Comparten la selecci?n inicial; cambia el transporte y la respuesta upstream.',
  },
];

const nodeCards = [
  {
    title: 'nas-local',
    kicker: 'Fast / fallback',
    note: 'RX780M para rutas ligeras y fallback consciente de memoria.',
    host: '192.168.1.250:1234',
    models: ['google/gemma-4-e4b', 'llama-3.2-1b-instruct'],
  },
  {
    title: 'rx7900xt-node',
    kicker: 'Coding / reasoning',
    note: 'Nodo de alta VRAM para coding, reasoning y orchestration.',
    host: '192.168.1.60:1234',
    models: ['qwen2.5-coder-32b', 'qwen2.5-coder-14b-instruct', 'google/gemma-4-26b-a4b'],
  },
  {
    title: 'rx9070-node',
    kicker: 'Vision / embeddings',
    note: 'Nodo multimodal para vision, embeddings y tareas creativas.',
    host: '192.168.1.50:1234',
    models: ['flux.2-klein-9b', 'moondream2-20250414', 'text-embedding-nomic-embed-text-v1.5'],
  },
];

const mcpCards = [
  {
    title: 'ailab_status',
    kicker: 'Herramientas MCP',
    note: 'Estado resumido de gateway y router. Solo lectura.',
  },
  {
    title: 'ailab_runtime_health',
    kicker: 'Herramientas MCP',
    note: 'Salud cognitiva y runtime detallada. Solo lectura.',
  },
  {
    title: 'ailab_route_preview',
    kicker: 'Herramientas MCP',
    note: 'Clasificaci?n heur?stica de rutas sin inferencia real.',
  },
];

const roadmapCurrent = [
  'AI-LAB-LMSTUDIO-NODE-PROFILES-01',
  'AI-LAB-ROUTER-AUTO-POLICY-TRACEABILITY-01',
  'AI-LAB-MCP-TOOLS-CATALOG-VALIDATION-01',
  'AI-LAB-GATEWAY-MODEL-PRESERVATION-POLICY-01',
  'AI-LAB-ASTRO-ROADMAP-REFRESH-NEXT-01',
];

const roadmapReserve = [
  'AILAB_MCP_TOKEN + LAN controlled mode',
  'Tools sem?nticas reales: sommelier, analyze_label, price_estimate',
  'Rioja Marketplace integration',
  'Multi-GPU runtime scheduler',
  'Hyper-V checkpoint',
];

const completed = [
  'AI-LAB-RUNTIME-HEALTH-SCORE-SEMANTICS-MERGE-PUSH-01',
  'AI-LAB-GRAFANA-HEALTH-SCORE-LABELING-PUSH-01',
  'AI-LAB-LMSTUDIO-RUNTIME-PERFORMANCE-BASELINE-PUSH-01',
  'AI-LAB-GEMMA-4-E4B-RUNTIME-SMOKE-PUSH-01',
  'AI-LAB-LMSTUDIO-STREAMING-VS-NONSTREAMING-BENCHMARK-PUSH-01',
  'AI-LAB-ROUTER-AUTO-DIAGNOSTIC-SOURCE-INSPECTION-PUSH',
];
---

<Layout title='AI Infrastructure ? AI-LAB'>
  <section class='mx-auto max-w-7xl px-6 py-16 space-y-10'>
    <header class='ai-visual-section rounded-3xl border border-cyan-500/30 bg-gradient-to-br from-zinc-900 via-zinc-950 to-black p-10'>
      <div class='flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.28em] text-cyan-300'>
        <span class='rounded-full border border-cyan-500/20 bg-cyan-500/10 px-3 py-1'>AI-LAB PLATFORM VIEW</span>
        <span class='rounded-full border border-zinc-700 bg-zinc-900 px-3 py-1 text-zinc-300'>read-only</span>
        <span class='rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-emerald-300'>visual standard applied</span>
      </div>
      <h1 class='mt-4 text-5xl font-black text-white'>Infraestructura AI-LAB</h1>
      <p class='mt-4 max-w-4xl text-xl leading-9 text-zinc-300'>
        Estado operativo con foco en salud del runtime, Benchmark LM Studio, Router Auto, MCP Tools y roadmap ejecutivo.
        El inventario f?sico vive en <a class='text-cyan-300 underline' href='/infra'>/infra</a>.
      </p>

      <div class='mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4'>
        {healthMetrics.map((item) => (
          <MetricBadge label={item.label} value={item.value} />
        ))}
      </div>
    </header>

    <VisualSection title='Estado consolidado' kicker='Se?ales operativas'>
      <div class='ai-visual-grid xl:grid-cols-4'>
        <VisualCard title='Runtime Health' kicker='Salud del runtime'>
          <p class='ai-visual-safe-text text-zinc-300'>La referencia can?nica es <code>ailab_cognitive_health_score</code>.</p>
        </VisualCard>
        <VisualCard title='Infra Cross-check' kicker='Cross-check de infraestructura'>
          <p class='ai-visual-safe-text text-zinc-300'>El control SLO usa <code>ai_lab:runtime_health_score</code> como validaci?n de infraestructura.</p>
        </VisualCard>
        <VisualCard title='Health Drift' kicker='Deriva de salud'>
          <p class='ai-visual-safe-text text-zinc-300'>La etiqueta de Grafana mantiene visible la deriva entre capas sin mezclar sem?nticas.</p>
        </VisualCard>
        <VisualCard title='Watchdog' kicker='Nodos de inferencia'>
          <p class='ai-visual-safe-text text-zinc-300'><code>no_nodes_online</code> es un disparador del watchdog, no una fotograf?a del estado actual.</p>
        </VisualCard>
      </div>
    </VisualSection>

    <VisualSection title='Benchmark LM Studio' kicker='Tiempos y throughput'>
      <div class='ai-visual-grid xl:grid-cols-4'>
        {benchmarkCards.map((card) => (
          <VisualCard title={card.title} kicker={card.kicker}>
            <p class='ai-visual-safe-text text-zinc-300'>{card.note}</p>
            {card.codes && (
              <p class='mt-3 ai-visual-safe-text text-sm text-zinc-300'>Modelo: {card.codes.map((code, index) => (<><code>{code}</code>{index < card.codes.length - 1 ? ', ' : ''}</>))}</p>
            )}
            <ul class='mt-4 space-y-2 ai-visual-safe-text text-sm text-zinc-300'>
              {card.bullets.map((item) => <li>- {item}</li>)}
            </ul>
          </VisualCard>
        ))}
      </div>
    </VisualSection>

    <VisualSection title='LM Studio Node Profiles' kicker='Topolog?a y policy'>
      <p class='max-w-4xl text-zinc-400 ai-visual-safe-text'>
        El nodo hardware y la policy viven separados: el registry define capacidades, el manifest define el perfil y el sistema visual no debe mezclar ambos planos.
      </p>
      <div class='mt-6 ai-visual-grid xl:grid-cols-3'>
        {nodeCards.map((node) => (
          <VisualCard title={node.title} kicker={node.kicker}>
            <p class='ai-visual-safe-text text-zinc-300'>{node.note}</p>
            <ul class='mt-4 space-y-2 ai-visual-safe-text text-sm text-zinc-300'>
              <li>- Host: <code>{node.host}</code></li>
              <li>- Modelos: {node.models.map((model, index) => (<><code>{model}</code>{index < node.models.length - 1 ? ', ' : ''}</>))}</li>
            </ul>
          </VisualCard>
        ))}
      </div>
      <div class='mt-6 ai-visual-grid md:grid-cols-2'>
        <VisualCard title='Perfiles declarativos' kicker='Manifest v21.1'>
          <ul class='space-y-2 ai-visual-safe-text text-sm text-zinc-300'>
            <li>- observe / minimal / greeting -> <code>observe_profile.json</code></li>
            <li>- chat / general / tool_use -> <code>chat_profile.json</code></li>
            <li>- coding / opencode_coding -> <code>coding_profile.json</code></li>
            <li>- reasoning / opencode_reasoning -> <code>analysis_profile.json</code></li>
          </ul>
        </VisualCard>
        <VisualCard title='Separaci?n de capas' kicker='Regla operativa'>
          <p class='ai-visual-safe-text text-zinc-300'>Las etiquetas deben quedar legibles sin convertir nombres t?cnicos largos en t?tulos de jerarqu?a alta.</p>
          <p class='mt-3 ai-visual-safe-text text-zinc-300'>La fase siguiente sigue siendo <code>AI-LAB-LMSTUDIO-NODE-PROFILES-01</code>.</p>
        </VisualCard>
      </div>
    </VisualSection>

    <VisualSection title='Router Auto' kicker='Selecci?n y trazabilidad'>
      <div class='ai-visual-grid lg:grid-cols-2 xl:grid-cols-3'>
        {routerCards.map((item) => (
          <VisualCard title={item.title} kicker={item.kicker}>
            <p class='ai-visual-safe-text text-zinc-300'>{item.note}</p>
            {item.codes && (
              <p class='mt-3 ai-visual-safe-text text-sm text-zinc-300'>C?digo: {item.codes.map((code, index) => (<><code>{code}</code>{index < item.codes.length - 1 ? ', ' : ''}</>))}</p>
            )}
          </VisualCard>
        ))}
      </div>
      <div class='mt-6 ai-visual-grid md:grid-cols-2'>
        <VisualCard title='Gemma' kicker='Smoke validado'>
          <p class='ai-visual-safe-text text-zinc-300'>La ruta expl?cita se conserva con <code>google/gemma-4-e4b</code> y el Gateway queda como seguimiento no urgente.</p>
        </VisualCard>
        <VisualCard title='Qwen Coder' kicker='Selecci?n can?nica'>
          <p class='ai-visual-safe-text text-zinc-300'>La policy can?nica de <code>ailab-router/auto</code> resuelve a <code>qwen/qwen2.5-coder-14b-instruct</code> para la ruta autom?tica.</p>
        </VisualCard>
      </div>
    </VisualSection>

    <VisualSection title='Herramientas MCP' kicker='Solo lectura'>
      <div class='ai-visual-grid lg:grid-cols-3'>
        {mcpCards.map((tool) => (
          <VisualCard title={tool.title} kicker={tool.kicker}>
            <p class='ai-visual-safe-text text-zinc-300'>{tool.note}</p>
          </VisualCard>
        ))}
      </div>
      <div class='mt-6 ai-visual-grid md:grid-cols-3'>
        <VisualCard title='Uso activo' kicker='Herramientas confirmadas'>
          <ul class='space-y-2 ai-visual-safe-text text-sm text-zinc-300'>
            <li>- <code>ailab_status</code></li>
            <li>- <code>ailab_runtime_health</code></li>
            <li>- <code>ailab_route_preview</code></li>
          </ul>
        </VisualCard>
        <VisualCard title='Condici?n de preview' kicker='Local y heur?stica'>
          <p class='ai-visual-safe-text text-zinc-300'>La herramienta de preview es local y heur?stica, no un endpoint HTTP del router.</p>
        </VisualCard>
        <VisualCard title='En preparaci?n' kicker='Sem?nticas futuras'>
          <ul class='space-y-2 ai-visual-safe-text text-sm text-zinc-300'>
            <li>- sommelier</li>
            <li>- analyze_label</li>
            <li>- price_estimate</li>
          </ul>
        </VisualCard>
      </div>
    </VisualSection>

    <VisualSection title='Hoja de ruta' kicker='Pendiente'>
      <div class='ai-visual-grid xl:grid-cols-3'>
        <RoadmapBlock title='Pr?xima fase' tone='emerald' items={roadmapCurrent} />
        <RoadmapBlock title='En reserva' tone='amber' items={roadmapReserve} />
        <RoadmapBlock title='Cerrado recientemente' tone='rose' items={completed} />
      </div>
    </VisualSection>

    <VisualSection title='Seguridad y notas' kicker='Publicaci?n'>
      <div class='ai-visual-grid md:grid-cols-3'>
        <VisualCard title='Idiomas' kicker='Operaci?n en espa?ol'>
          <p class='ai-visual-safe-text text-zinc-300'>El resumen operativo, los estados y la navegaci?n visible se mantienen en espa?ol.</p>
        </VisualCard>
        <VisualCard title='Secretos' kicker='Validaci?n'>
          <p class='ai-visual-safe-text text-zinc-300'>No se exponen secretos reales. <code>AILAB_MCP_TOKEN</code> solo aparece como nombre de variable.</p>
        </VisualCard>
        <VisualCard title='Publicaci?n' kicker='Visual gate'>
          <p class='ai-visual-safe-text text-zinc-300'>La aceptaci?n exige revisi?n visual; compilar no basta.</p>
        </VisualCard>
      </div>
    </VisualSection>
  </section>
</Layout>
