---
import Layout from '../../layouts/Layout.astro';

const pillClass = (tone) => {
  if (tone === 'emerald') return 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300';
  if (tone === 'cyan') return 'border-cyan-500/30 bg-cyan-500/10 text-cyan-300';
  if (tone === 'amber') return 'border-amber-500/30 bg-amber-500/10 text-amber-300';
  return 'border-rose-500/30 bg-rose-500/10 text-rose-300';
};

const badgeClass = {
  confirmed: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300',
  active: 'border-cyan-500/30 bg-cyan-500/10 text-cyan-300',
  standby: 'border-zinc-700 bg-zinc-900 text-zinc-300',
  pending: 'border-yellow-500/30 bg-yellow-500/10 text-yellow-300',
  reserved: 'border-rose-500/30 bg-rose-500/10 text-rose-300',
  readonly: 'border-cyan-500/30 bg-cyan-500/10 text-cyan-300',
  operator: 'border-amber-500/30 bg-amber-500/10 text-amber-300',
};

const riskBadgeClass = {
  low: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300',
  medium: 'border-yellow-500/30 bg-yellow-500/10 text-yellow-300',
  high: 'border-rose-500/30 bg-rose-500/10 text-rose-300',
};

const mcpTools = [
  { name: 'ailab_status', status: 'confirmed', use: 'active', risk: 'low', note: 'Estado resumido de gateway y router. Solo lectura.' },
  { name: 'ailab_runtime_health', status: 'confirmed', use: 'active', risk: 'low', note: 'Salud cognitiva y runtime detallada. Solo lectura.' },
  { name: 'ailab_route_preview', status: 'confirmed', use: 'active', risk: 'low', note: 'Clasificacion heuristica de rutas sin inferencia real.' },
];

const kpis = [
  { label: 'Runtime / Cognitive Health', value: 'ailab_cognitive_health_score', tone: 'emerald', note: 'Health canonico del runtime y plano cognitivo.' },
  { label: 'Infra / SLO Cross-check', value: 'ai_lab:runtime_health_score', tone: 'cyan', note: 'Cross-check operativo de SLO e infraestructura.' },
  { label: 'Health Drift', value: 'Grafana label estable', tone: 'amber', note: 'El drift queda visible como divergencia entre capas.' },
  { label: 'Inference Nodes Online', value: 'no_nodes_online = watchdog trigger', tone: 'rose', note: 'Es disparador del watchdog, no estado actual.' },
];

const benchmarks = [
  { label: 'Gateway baseline', value: '10.40 tps', note: 'Rango 10.03 / 10.78 tps en la baseline LM Studio.' },
  { label: 'Streaming benchmark', value: '6.19 tps', note: 'Media non-streaming. Streaming estimado: 4.20 tps.' },
  { label: 'Streaming TTFB', value: '28.401s', note: 'TTFB alto en la muestra streaming del benchmark.' },
  { label: 'Router Gemma non-streaming', value: '11.17 tps', note: 'Muestra Router con google/gemma-4-e4b explícito.' },
  { label: 'Router sample', value: '2.79 tps', note: 'Muestra base del Router en la baseline LM Studio.' },
  { label: 'LM Studio UI note', value: 'No comparable', note: 'Los tps internos de la UI no equivalen al end-to-end API.' },
];

const routerFacts = [
  { title: 'Ruta canonica', text: 'ailab-router/auto mapea por defecto a qwen/qwen2.5-coder-14b-instruct en la policy.' },
  { title: 'Ranking real', text: 'choose_model() rankea por capability, performance y health antes de elegir nodo/modelo.' },
  { title: 'Preservacion Gemma', text: 'Router preserva google/gemma-4-e4b cuando se pide de forma explicita.' },
  { title: 'Auto sin override especial', text: 'ailab-router/auto no tiene override especial para Gemma.' },
  { title: 'Selector de capability', text: 'router_api usa capability_from_model() solo para /fast, /reasoning y /coding.' },
  { title: 'Streaming y non-streaming', text: 'Comparten la seleccion inicial; la diferencia viene de la respuesta upstream y el transporte.' },
];

const roadmap = [
  { title: 'Próximo bloque recomendado', tone: 'emerald', items: ['AI-LAB-LMSTUDIO-NODE-PROFILES-01'] },
  { title: 'Fases para mañana', tone: 'amber', items: ['AI-LAB-LMSTUDIO-NODE-PROFILES-01', 'AI-LAB-ROUTER-AUTO-POLICY-TRACEABILITY-01', 'AI-LAB-MCP-TOOLS-CATALOG-VALIDATION-01', 'AI-LAB-GATEWAY-MODEL-PRESERVATION-POLICY-01', 'AI-LAB-ASTRO-ROADMAP-REFRESH-NEXT-01'] },
  { title: 'Pendientes en reserva', tone: 'rose', items: ['AILAB_MCP_TOKEN + LAN controlled mode', 'Tools semanticas reales: sommelier, analyze_label, price_estimate', 'Rioja Marketplace integration', 'Multi-GPU runtime scheduler', 'Hyper-V checkpoint'] },
];

const completed = [
  'AI-LAB-RUNTIME-HEALTH-SCORE-SEMANTICS-MERGE-PUSH-01',
  'AI-LAB-GRAFANA-HEALTH-SCORE-LABELING-PUSH-01',
  'AI-LAB-LMSTUDIO-RUNTIME-PERFORMANCE-BASELINE-PUSH-01',
  'AI-LAB-GEMMA-4-E4B-RUNTIME-SMOKE-PUSH-01',
  'AI-LAB-LMSTUDIO-STREAMING-VS-NONSTREAMING-BENCHMARK-PUSH-01',
  'AI-LAB-ROUTER-AUTO-DIAGNOSTIC-SOURCE-INSPECTION-PUSH',
];

const securityNotes = [
  'AILAB_MCP_TOKEN es solo nombre de variable, no valor real expuesto.',
  'route preview es MCP local heuristico, no endpoint HTTP del router.',
  'No se exponen secretos, credenciales ni tokens reales en esta pagina.',
];
---

<Layout title='AI Infrastructure · AI-LAB'>
  <section class='mx-auto max-w-7xl px-6 py-16 space-y-10'>
    <header class='rounded-3xl border border-cyan-500/30 bg-gradient-to-br from-zinc-900 via-zinc-950 to-black p-10'>
      <div class='flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.28em] text-cyan-300'>
        <span class='rounded-full border border-cyan-500/20 bg-cyan-500/10 px-3 py-1'>AI-LAB PLATFORM VIEW</span>
        <span class='rounded-full border border-zinc-700 bg-zinc-900 px-3 py-1 text-zinc-300'>read-only</span>
        <span class='rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-emerald-300'>visual standard applied</span>
      </div>
      <h1 class='mt-4 text-5xl font-black text-white'>AI Infrastructure</h1>
      <p class='mt-4 max-w-4xl text-xl leading-9 text-zinc-300'>
        Estado operativo de la plataforma AI-LAB con foco en salud cognitiva, benchmarks de LM Studio, router auto, MCP tools y roadmap ejecutivo.
        El inventario fisico vive en <a class='text-cyan-300 underline' href='/infra'>/infra</a>.
      </p>

      <div class='mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4'>
        {kpis.map((item) => (
          <div class='rounded-2xl border border-zinc-800 bg-black/30 p-5'>
            <p class='text-xs uppercase tracking-wider text-cyan-400'>{item.label}</p>
            <p class='mt-3 text-2xl font-black text-white'>{item.value}</p>
            <p class='mt-3 text-zinc-300'>{item.note}</p>
            <span class={'mt-4 inline-flex rounded-full border px-3 py-1 text-[11px] uppercase tracking-[0.2em] ' + pillClass(item.tone)}>{item.tone}</span>
          </div>
        ))}
      </div>
    </header>

    <section class='rounded-2xl border border-zinc-800 bg-zinc-950 p-8'>
      <div class='flex flex-wrap items-end justify-between gap-4'>
        <div>
          <h2 class='text-2xl font-black text-cyan-400'>Estado consolidado</h2>
          <p class='mt-2 max-w-3xl text-zinc-400'>
            Las capas de salud ya estan separadas: el score canónico del runtime no es el cross-check de infraestructura, y el watchdog usa no_nodes_online como trigger, no como estado actual.
          </p>
        </div>
      </div>

      <div class='mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4'>
        <div class='rounded-2xl border border-zinc-800 bg-black/30 p-5'>
          <p class='text-xs uppercase tracking-wider text-emerald-400'>Runtime health</p>
          <p class='mt-2 text-zinc-300'>ailab_cognitive_health_score es la referencia canónica del runtime y del plano cognitivo.</p>
        </div>
        <div class='rounded-2xl border border-zinc-800 bg-black/30 p-5'>
          <p class='text-xs uppercase tracking-wider text-cyan-400'>Infra cross-check</p>
          <p class='mt-2 text-zinc-300'>ai_lab:runtime_health_score sigue siendo un cross-check SLO e infraestructura, no el canonical runtime score.</p>
        </div>
        <div class='rounded-2xl border border-zinc-800 bg-black/30 p-5'>
          <p class='text-xs uppercase tracking-wider text-amber-400'>Grafana labeling</p>
          <p class='mt-2 text-zinc-300'>Runtime/Cognitive Health Score, Infra/SLO Cross-check, Health Drift e Inference Nodes Online ya estan etiquetados correctamente.</p>
        </div>
        <div class='rounded-2xl border border-zinc-800 bg-black/30 p-5'>
          <p class='text-xs uppercase tracking-wider text-rose-400'>Watchdog</p>
          <p class='mt-2 text-zinc-300'>no_nodes_online es un disparador del watchdog, no una fotografia del estado actual.</p>
        </div>
      </div>
    </section>

    <section class='rounded-2xl border border-zinc-800 bg-zinc-950 p-8'>
      <h2 class='text-2xl font-black text-cyan-400 mb-6'>Runtime Performance / LM Studio</h2>
      <div class='grid gap-4 md:grid-cols-2 xl:grid-cols-3'>
        {benchmarks.map((item) => (
          <div class='rounded-2xl border border-zinc-800 bg-black/30 p-5'>
            <p class='text-xs uppercase tracking-wider text-cyan-400'>{item.label}</p>
            <p class='mt-3 text-3xl font-black text-white'>{item.value}</p>
            <p class='mt-3 text-zinc-300'>{item.note}</p>
          </div>
        ))}
      </div>
      <div class='mt-6 rounded-2xl border border-cyan-500/20 bg-cyan-950/10 p-5'>
        <p class='text-sm uppercase tracking-[0.25em] text-cyan-300'>Interpretacion operativa</p>
        <p class='mt-2 text-zinc-300'>La UI de LM Studio puede mostrar tps internos que no son comparables con los tiempos end-to-end del API. Para seguimiento serio, usar la baseline y el benchmark streaming/non-streaming publicados.</p>
      </div>
    </section>

    <section class='rounded-2xl border border-zinc-800 bg-zinc-950 p-8'>
      <h2 class='text-2xl font-black text-cyan-400 mb-6'>Router Auto</h2>
      <div class='grid gap-4 lg:grid-cols-2 xl:grid-cols-3'>
        {routerFacts.map((item) => (
          <div class='rounded-2xl border border-zinc-800 bg-black/30 p-5'>
            <p class='text-sm font-semibold text-white'>{item.title}</p>
            <p class='mt-2 text-zinc-300'>{item.text}</p>
          </div>
        ))}
      </div>
      <div class='mt-6 grid gap-4 md:grid-cols-2'>
        <div class='rounded-2xl border border-emerald-500/20 bg-emerald-950/10 p-5'>
          <p class='text-xs uppercase tracking-[0.25em] text-emerald-300'>Gemma smoke</p>
          <p class='mt-2 text-zinc-300'>Router preserva google/gemma-4-e4b cuando se solicita de forma explicita. Eso si, el Gateway no siempre preserva el modelo solicitado.</p>
        </div>
        <div class='rounded-2xl border border-yellow-500/20 bg-yellow-950/10 p-5'>
          <p class='text-xs uppercase tracking-[0.25em] text-yellow-300'>Estado no urgente</p>
          <p class='mt-2 text-zinc-300'>La preservacion de modelo en Gateway queda como seguimiento no urgente; la trazabilidad de auto ya quedo documentada a nivel de source.</p>
        </div>
      </div>
    </section>

    <section class='rounded-2xl border border-zinc-800 bg-zinc-950 p-8'>
      <h2 class='text-2xl font-black text-cyan-400 mb-6'>MCP Tools</h2>
      <div class='grid gap-6 lg:grid-cols-3'>
        {mcpTools.map((tool) => (
          <div class='rounded-2xl border border-zinc-800 bg-black/30 p-5'>
            <p class='text-sm font-semibold text-white'>{tool.name}</p>
            <p class='mt-2 text-zinc-300'>{tool.note}</p>
            <div class='mt-4 flex flex-wrap gap-2 text-[11px] uppercase tracking-[0.2em]'>
              <span class={'rounded-full border px-3 py-1 ' + badgeClass[tool.status]}>{tool.status}</span>
              <span class={'rounded-full border px-3 py-1 ' + badgeClass[tool.use]}>{tool.use}</span>
              <span class={'rounded-full border px-3 py-1 ' + riskBadgeClass[tool.risk]}>{tool.risk} risk</span>
            </div>
          </div>
        ))}
      </div>
      <div class='mt-6 grid gap-4 md:grid-cols-3'>
        <div class='rounded-xl bg-black/30 p-5'>
          <p class='text-sm text-zinc-500 font-bold'>Uso activo</p>
          <ul class='mt-2 space-y-2 text-zinc-300 text-sm'>
            <li>• ailab_status</li>
            <li>• ailab_runtime_health</li>
            <li>• ailab_route_preview</li>
          </ul>
        </div>
        <div class='rounded-xl bg-black/30 p-5'>
          <p class='text-sm text-zinc-500 font-bold'>Condicion de la tool de preview</p>
          <p class='mt-2 text-zinc-300 text-sm'>ailab_route_preview es local y heuristica, no un endpoint HTTP del router.</p>
        </div>
        <div class='rounded-xl bg-black/30 p-5'>
          <p class='text-sm text-zinc-500 font-bold'>En preparación</p>
          <ul class='mt-2 space-y-2 text-zinc-300 text-sm'>
            <li>• sommelier</li>
            <li>• analyze_label</li>
            <li>• price_estimate</li>
          </ul>
        </div>
      </div>
    </section>

    <section class='rounded-2xl border border-zinc-800 bg-zinc-950 p-8'>
      <h2 class='text-2xl font-black text-cyan-400 mb-6'>Roadmap / Pendiente</h2>
      <div class='grid gap-6 xl:grid-cols-3'>
        {roadmap.map((block) => (
          <div class={'rounded-xl border p-6 ' + (block.tone === 'emerald' ? 'border-emerald-500/30 bg-emerald-950/10' : block.tone === 'amber' ? 'border-yellow-500/30 bg-yellow-950/10' : 'border-rose-500/30 bg-rose-950/10')}>
            <p class={'mb-3 text-sm uppercase tracking-wider ' + (block.tone === 'emerald' ? 'text-emerald-400' : block.tone === 'amber' ? 'text-yellow-400' : 'text-rose-400')}>{block.title}</p>
            <ul class='space-y-2 text-zinc-400 text-sm'>
              {block.items.map((item) => <li>• {item}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <div class='mt-6 grid gap-4 md:grid-cols-2'>
        <div class='rounded-2xl border border-emerald-500/20 bg-emerald-950/10 p-6'>
          <p class='text-xs uppercase tracking-[0.25em] text-emerald-300'>Cerrado recientemente</p>
          <ul class='mt-3 space-y-2 text-zinc-300 text-sm'>
            {completed.map((item) => <li>• {item}</li>)}
          </ul>
        </div>
        <div class='rounded-2xl border border-amber-500/20 bg-amber-950/10 p-6'>
          <p class='text-xs uppercase tracking-[0.25em] text-amber-300'>Siguiente fase recomendada</p>
          <p class='mt-3 text-zinc-300'>AI-LAB-LMSTUDIO-NODE-PROFILES-01 como bloque siguiente para aterrizar perfiles por nodo y modelo.</p>
        </div>
      </div>
    </section>

    <section class='rounded-2xl border border-zinc-800 bg-zinc-950 p-8'>
      <h2 class='text-2xl font-black text-cyan-400 mb-6'>Seguridad y notas</h2>
      <div class='grid gap-4 md:grid-cols-3'>
        {securityNotes.map((note) => (
          <div class='rounded-xl bg-black/30 p-5'>
            <p class='text-zinc-300'>{note}</p>
          </div>
        ))}
      </div>
      <div class='mt-6 grid gap-4 lg:grid-cols-2'>
        <div class='rounded-2xl border border-cyan-500/20 bg-cyan-950/10 p-6'>
          <p class='text-xs uppercase tracking-[0.25em] text-cyan-300'>Checklist visual</p>
          <ul class='mt-3 space-y-2 text-sm text-zinc-300'>
            <li>• Hero premium con contexto operativo.</li>
            <li>• Cards ejecutivas para el resumen.</li>
            <li>• Roadmap claro y corto, no changelog largo.</li>
            <li>• Matriz visual para MCP Tools.</li>
          </ul>
        </div>
        <div class='rounded-2xl border border-amber-500/20 bg-amber-950/10 p-6'>
          <p class='text-xs uppercase tracking-[0.25em] text-amber-300'>Proxima limpieza</p>
          <p class='mt-3 text-zinc-300'>La siguiente fase de refresco documental debe concentrarse en nodos LM Studio y el refinamiento de perfiles antes de abrir superficies mutables.</p>
        </div>
      </div>
    </section>
  </section>
</Layout>
