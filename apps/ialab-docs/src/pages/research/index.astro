---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Research · AI-LAB">
  <section class="space-y-10">
    <div class="rounded-3xl border border-cyan-500/30 bg-gradient-to-br from-zinc-900 to-black p-10">
      <p class="text-sm uppercase tracking-[0.3em] text-cyan-400">AI-LAB Research</p>
      <h1 class="mt-6 text-5xl font-black text-white">Research</h1>
      <p class="mt-6 max-w-4xl text-xl text-zinc-300">
        Investigación aplicada en observabilidad, telemetría, análisis temporal, infraestructura cognitiva y cognición estructural del código fuente.
      </p>
    </div>

    <section class="grid gap-6 md:grid-cols-2">
      <a href="/research/structural-cognition" class="block rounded-2xl border border-purple-500/20 bg-zinc-950 p-6 hover:border-purple-400/50 transition">
        <span class="text-xs uppercase tracking-wider text-purple-400">DEV-36X</span>
        <h2 class="mt-3 text-2xl font-black text-white">Cognición Estructural de la Codebase</h2>
        <p class="mt-2 text-zinc-400">Integración GitNexus, capas de verdad, flujo del grafo de dependencias y hallazgos clave sobre la correlación runtime ↔ codebase.</p>
        <div class="mt-4 flex gap-2 flex-wrap">
          <span class="px-2 py-1 text-xs rounded bg-zinc-800 text-zinc-300">GitNexus</span>
          <span class="px-2 py-1 text-xs rounded bg-zinc-800 text-zinc-300">Grafo de Dependencias</span>
          <span class="px-2 py-1 text-xs rounded bg-zinc-800 text-zinc-300">Blast Radius</span>
        </div>
      </a>
    </section>
  </section>
</Layout>
