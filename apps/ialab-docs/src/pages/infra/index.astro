---
import Layout from "../../layouts/Layout.astro";
import { infraInventory } from "../../lib/infraInventory";

const { summary, nodes, network, capabilities, pending, security } = infraInventory;
---

<Layout title="Infrastructure Inventory · AI-LAB">
  <section class="space-y-10">
    <header class="rounded-3xl border border-cyan-500/30 bg-zinc-950 p-8">
      <p class="text-sm uppercase tracking-[0.35em] text-cyan-400">AI-LAB INFRASTRUCTURE</p>
      <h1 class="mt-5 text-5xl font-black text-white">Infrastructure Inventory</h1>
      <p class="mt-4 max-w-4xl text-lg leading-8 text-zinc-300">
        Inventario físico y de red del laboratorio AI-LAB. Versión sanitizada para publicación operativa,
        con foco en nodos, conectividad y capacidades reales.
      </p>

      <div class="mt-6 flex flex-wrap gap-2 text-xs uppercase tracking-[0.2em] text-zinc-300">
        <span class="rounded-full border border-cyan-500/20 bg-cyan-500/10 px-3 py-1 text-cyan-300">3 nodos físicos</span>
        <span class="rounded-full border border-cyan-500/20 bg-cyan-500/10 px-3 py-1 text-cyan-300">2 workstations GPU</span>
        <span class="rounded-full border border-cyan-500/20 bg-cyan-500/10 px-3 py-1 text-cyan-300">1 NAS / Hyper-V</span>
        <span class="rounded-full border border-cyan-500/20 bg-cyan-500/10 px-3 py-1 text-cyan-300">UniFi 10 Gb / 2.5 Gb</span>
        <span class="rounded-full border border-cyan-500/20 bg-cyan-500/10 px-3 py-1 text-cyan-300">Wi-Fi 7</span>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-2xl border border-zinc-800 bg-black/30 p-4">
          <p class="text-xs uppercase tracking-[0.2em] text-zinc-500">Updated</p>
          <p class="mt-2 text-zinc-200">{infraInventory.generated_at}</p>
        </div>
        <div class="rounded-2xl border border-zinc-800 bg-black/30 p-4">
          <p class="text-xs uppercase tracking-[0.2em] text-zinc-500">Visibility</p>
          <p class="mt-2 text-zinc-200">{infraInventory.visibility}</p>
        </div>
        <div class="rounded-2xl border border-zinc-800 bg-black/30 p-4">
          <p class="text-xs uppercase tracking-[0.2em] text-zinc-500">Cabling</p>
          <p class="mt-2 text-zinc-200">{summary.cabling}</p>
        </div>
        <div class="rounded-2xl border border-zinc-800 bg-black/30 p-4">
          <p class="text-xs uppercase tracking-[0.2em] text-zinc-500">Network</p>
          <p class="mt-2 text-zinc-200">{summary.network}</p>
        </div>
      </div>
    </header>

    <section class="rounded-3xl border border-cyan-500/20 bg-black/40 p-8">
      <h2 class="text-3xl font-black text-white">Executive Summary</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-2xl border border-cyan-500/20 bg-zinc-950 p-5">
          <p class="text-xs uppercase tracking-[0.2em] text-cyan-400">Physical nodes</p>
          <p class="mt-3 text-3xl font-black text-white">{summary.physical_nodes}</p>
        </div>
        <div class="rounded-2xl border border-cyan-500/20 bg-zinc-950 p-5">
          <p class="text-xs uppercase tracking-[0.2em] text-cyan-400">GPU workstations</p>
          <p class="mt-3 text-3xl font-black text-white">{summary.gpu_workstations}</p>
        </div>
        <div class="rounded-2xl border border-cyan-500/20 bg-zinc-950 p-5">
          <p class="text-xs uppercase tracking-[0.2em] text-cyan-400">NAS / Hyper-V</p>
          <p class="mt-3 text-3xl font-black text-white">{summary.nas_hyperv_nodes}</p>
        </div>
        <div class="rounded-2xl border border-cyan-500/20 bg-zinc-950 p-5">
          <p class="text-xs uppercase tracking-[0.2em] text-cyan-400">Wi-Fi</p>
          <p class="mt-3 text-3xl font-black text-white">{summary.wifi}</p>
        </div>
      </div>
    </section>

    <section class="rounded-3xl border border-zinc-800 bg-zinc-950 p-8">
      <h2 class="text-3xl font-black text-white">Node Inventory</h2>
      <div class="mt-6 overflow-x-auto rounded-2xl border border-zinc-800">
        <table class="min-w-full divide-y divide-zinc-800 text-left text-sm">
          <thead class="bg-black/40 text-xs uppercase tracking-[0.2em] text-zinc-500">
            <tr>
              <th class="px-4 py-3">Nodo</th>
              <th class="px-4 py-3">Rol</th>
              <th class="px-4 py-3">CPU</th>
              <th class="px-4 py-3">GPU</th>
              <th class="px-4 py-3">RAM</th>
              <th class="px-4 py-3">Storage</th>
              <th class="px-4 py-3">Red</th>
              <th class="px-4 py-3">Sistema / función</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-800 bg-zinc-950 text-zinc-300">
            {nodes.map((node) => (
              <tr class="align-top">
                <td class="px-4 py-4 font-semibold text-white">{node.name}</td>
                <td class="px-4 py-4">{node.role}</td>
                <td class="px-4 py-4">{node.cpu}</td>
                <td class="px-4 py-4">{node.gpu}</td>
                <td class="px-4 py-4">{node.ram}</td>
                <td class="px-4 py-4">{node.storage}</td>
                <td class="px-4 py-4">{node.network}</td>
                <td class="px-4 py-4">{node.system}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="grid gap-6 lg:grid-cols-3">
      {nodes.map((node) => (
        <article class="rounded-3xl border border-cyan-500/20 bg-zinc-950/80 p-7">
          <p class="text-xs uppercase tracking-[0.25em] text-cyan-400">{node.role}</p>
          <h2 class="mt-3 text-2xl font-black text-white">{node.name}</h2>
          <p class="mt-3 text-sm leading-6 text-zinc-300">{node.storage}</p>

          <div class="mt-6 space-y-3">
            {node.details.map((detail) => (
              <div class="rounded-2xl border border-zinc-800 bg-black/30 p-4">
                <p class="text-xs uppercase tracking-[0.2em] text-zinc-500">{detail.label}</p>
                <p class="mt-2 text-sm text-zinc-200">{detail.value}</p>
              </div>
            ))}
          </div>
        </article>
      ))}
    </section>

    <section class="grid gap-6 lg:grid-cols-2">
      <article class="rounded-3xl border border-zinc-800 bg-zinc-950 p-8">
        <h2 class="text-3xl font-black text-white">Network Topology</h2>
        <div class="mt-6 space-y-4 text-sm text-zinc-300">
          <div class="rounded-2xl border border-zinc-800 bg-black/30 p-4">
            <p class="text-xs uppercase tracking-[0.2em] text-zinc-500">Gateway</p>
            <p class="mt-2 text-zinc-200">{network.gateway.name}</p>
            <p class="mt-2 text-zinc-400">Uplink: {network.gateway.uplink}</p>
            <p class="mt-1 text-zinc-400">Handoff: {network.gateway.handoff}</p>
            <p class="mt-1 text-zinc-400">Trunk: {network.gateway.trunk}</p>
          </div>
          <div class="rounded-2xl border border-zinc-800 bg-black/30 p-4">
            <p class="text-xs uppercase tracking-[0.2em] text-zinc-500">Switch</p>
            <p class="mt-2 text-zinc-200">{network.switch.name}</p>
            <p class="mt-2 text-zinc-400">{network.switch.port}</p>
            <p class="mt-1 text-zinc-400">Uplink: {network.switch.uplink}</p>
          </div>
          <div class="rounded-2xl border border-zinc-800 bg-black/30 p-4">
            <p class="text-xs uppercase tracking-[0.2em] text-zinc-500">Access points</p>
            <div class="mt-3 space-y-2">
              {network.aps.map((ap) => (
                <p class="text-zinc-200">{ap.name} · puerto {ap.port}</p>
              ))}
            </div>
          </div>
          <div class="rounded-2xl border border-zinc-800 bg-black/30 p-4">
            <p class="text-xs uppercase tracking-[0.2em] text-zinc-500">Cableado</p>
            <p class="mt-2 text-zinc-200">{network.cabling} · tirada máxima {network.longest_run}</p>
          </div>
        </div>
      </article>

      <article class="rounded-3xl border border-zinc-800 bg-zinc-950 p-8">
        <h2 class="text-3xl font-black text-white">Topology Diagram</h2>
        <pre class="mermaid mt-6 rounded-2xl bg-black/30 p-6 text-sm">
flowchart TD
  ISP["Telefónica 1 GbE<br/>SFP GPON Telefónica"] --> UCG["UCG Fiber / Cloud Gateway Fiber"]
  UCG -->|SFP+ 10 Gb| USW["USW Flex 2.5G 8 PoE"]
  USW -->|Port 3| AP1["U7 In-Wall"]
  USW -->|Port 7| AP2["U7 Lite"]
  USW --> NAS["NAS-N5 / Hyper-V Host"]
  USW --> GPU1["GPU Workstation A"]
  USW --> GPU2["GPU Workstation B"]
        </pre>
      </article>
    </section>

    <section class="grid gap-6 lg:grid-cols-2">
      <article class="rounded-3xl border border-cyan-500/20 bg-zinc-950 p-8">
        <h2 class="text-3xl font-black text-white">Current Capabilities</h2>
        <ul class="mt-5 space-y-3 text-zinc-300">
          {capabilities.map((item) => <li>• {item}</li>)}
        </ul>
      </article>

      <article class="rounded-3xl border border-yellow-500/20 bg-zinc-950 p-8">
        <h2 class="text-3xl font-black text-white">Pending / Future Work</h2>
        <ul class="mt-5 space-y-3 text-zinc-300">
          {pending.map((item) => <li>• {item}</li>)}
        </ul>
      </article>
    </section>

    <section class="rounded-3xl border border-zinc-800 bg-zinc-950 p-8">
      <h2 class="text-3xl font-black text-white">Sanitization & Notes</h2>
      <div class="mt-6 grid gap-4 lg:grid-cols-2">
        <div class="rounded-2xl border border-zinc-800 bg-black/30 p-5">
          <p class="text-xs uppercase tracking-[0.2em] text-zinc-500">Excluded data</p>
          <ul class="mt-3 space-y-2 text-zinc-300">
            {security.excluded.map((item) => <li>• {item}</li>)}
          </ul>
        </div>
        <div class="rounded-2xl border border-zinc-800 bg-black/30 p-5">
          <p class="text-xs uppercase tracking-[0.2em] text-zinc-500">Publication notes</p>
          <ul class="mt-3 space-y-2 text-zinc-300">
            {security.notes.map((item) => <li>• {item}</li>)}
          </ul>
        </div>
      </div>
    </section>
  </section>

  <script>
    import mermaid from "mermaid";
    mermaid.initialize({ startOnLoad: true, theme: "dark", securityLevel: "loose" });
  </script>
</Layout>
