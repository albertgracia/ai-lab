---
import Layout from "../../layouts/Layout.astro";

const lastCheckpoint = "CP-AI-LAB-ASTRO-PUBLIC-PRIVATE-ACTUALIZATION-02";
const lastCommit = "4483722";
const lastUpdate = "2026-07-06";
const buildPages = { public: 144, private: 281 };

const status = [
  { name: "Runtime", status: "operational", detail: "3 modelos activos, SLO + Adaptive Concurrency" },
  { name: "Gateway", status: "operational", detail: ":8008 — OpenAI-compatible" },
  { name: "Router", status: "operational", detail: ":8083 — API interna" },
  { name: "GitNexus", status: "operational", detail: "20K+ símbolos, 32K+ relaciones" },
  { name: "Hermes Enterprise", status: "operational", detail: "Core completado — 185 tests, 6 componentes" },
  { name: "AnythingLLM Enterprise", status: "operational", detail: "1304 vectores, 7 workspaces RAG" },
  { name: "Marketplace Digital Twin", status: "operational", detail: "Go + Fiber v2, Next.js 15" },
  { name: "Observabilidad", status: "operational", detail: "100+ métricas, 19 alertas activas" },
  { name: "Astro Público", status: "operational", detail: "ai-lab.labrazahome.com — 144 páginas" },
  { name: "Astro Privado", status: "operational", detail: "blog-ai-lab.labrazahome.com — 281 páginas" },
];

const nextPhase = "Hermes E08 — Lifecycle Hooks";
---

<Layout title="Estado del Laboratorio · AI-LAB">

<section class="space-y-10">

  <header class="rounded-3xl border border-cyan-500/30 bg-zinc-950 p-8">
    <p class="text-sm uppercase tracking-[0.35em] text-cyan-400">AI-LAB</p>
    <h1 class="mt-5 text-5xl font-black text-white">Estado del Laboratorio</h1>
    <p class="mt-4 max-w-4xl text-lg leading-8 text-zinc-300">
      Fotografía documental del estado actual del ecosistema AI-LAB.
      No es un dashboard en tiempo real. Es una instantánea verificada.
    </p>
  </header>

  <section class="rounded-2xl border border-zinc-800 bg-zinc-900 p-8">
    <h2 class="text-3xl font-black text-white">Estado General</h2>

    <div class="mt-8 grid gap-4">
      {
        status.map((item) => (
          <div class="flex items-center justify-between rounded-xl border border-zinc-800 bg-zinc-950 p-5">
            <div>
              <p class="font-semibold text-white">{item.name}</p>
              <p class="text-sm text-zinc-400">{item.detail}</p>
            </div>
            <span class="flex items-center gap-2 text-sm font-medium text-green-400">
              <span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
              {item.status === "operational" ? "Operativo" : item.status}
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="grid gap-6 md:grid-cols-2">
    <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
      <p class="text-sm uppercase tracking-[0.3em] text-zinc-500">Próxima fase</p>
      <p class="mt-3 text-xl font-bold text-cyan-400">{nextPhase}</p>
    </div>

    <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
      <p class="text-sm uppercase tracking-[0.3em] text-zinc-500">Último Checkpoint</p>
      <p class="mt-3 text-xl font-bold text-white">{lastCheckpoint}</p>
    </div>

    <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
      <p class="text-sm uppercase tracking-[0.3em] text-zinc-500">Último Commit público</p>
      <p class="mt-3 text-xl font-bold text-white font-mono">{lastCommit}</p>
    </div>

    <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
      <p class="text-sm uppercase tracking-[0.3em] text-zinc-500">Última actualización</p>
      <p class="mt-3 text-xl font-bold text-white">{lastUpdate}</p>
    </div>
  </section>

  <section class="rounded-2xl border border-zinc-800 bg-zinc-900 p-8">
    <h2 class="text-3xl font-black text-white">Builds</h2>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="rounded-xl bg-zinc-950 p-5">
        <p class="text-sm text-zinc-500">Público</p>
        <p class="mt-2 text-3xl font-bold text-white">{buildPages.public} páginas</p>
        <p class="text-sm text-green-400">0 errores · 0 IPs internas</p>
      </div>
      <div class="rounded-xl bg-zinc-950 p-5">
        <p class="text-sm text-zinc-500">Privado</p>
        <p class="mt-2 text-3xl font-bold text-white">{buildPages.private} páginas</p>
        <p class="text-sm text-green-400">0 errores</p>
      </div>
    </div>
  </section>

  <div class="flex justify-center">
    <a href="/" class="rounded-xl border border-zinc-700 px-6 py-3 font-bold text-zinc-200 hover:border-cyan-400 hover:text-cyan-400">
      ← Volver al inicio
    </a>
  </div>

</section>

</Layout>
