---
import Layout from "../../../layouts/Layout.astro";
---

<Layout title="GPU Telemetry · AI-LAB">
  <section class="mx-auto max-w-7xl px-6 py-16 space-y-10">
    <header class="rounded-3xl border border-cyan-500/30 bg-zinc-950 p-10">
      <h1 class="text-5xl font-black text-white">GPU Live Telemetry</h1>
      <p class="mt-4 max-w-4xl text-lg text-zinc-400">
        Telemetria en tiempo real de las GPUs de inferencia via API de eventos y Prometheus.
      </p>
    </header>

    <section class="rounded-xl border border-zinc-800 bg-zinc-950/80 p-5 text-sm text-zinc-400">
      <span class="font-bold text-emerald-400" id="gpu-source">LIVE</span>
      · <span id="gpu-updated">última actualización: --</span>
      · <span id="gpu-summary">GPU nodes: --</span>
    </section>

    <section id="gpu-cards" class="grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-zinc-800 bg-zinc-950 p-6">
        <h2 class="text-xl font-bold text-orange-400">RX9070</h2>
        <p class="text-sm text-zinc-500">192.168.1.50 · 16GB VRAM</p>
        <div class="mt-4 grid grid-cols-2 gap-4">
          <div><p class="text-xs text-zinc-500">VRAM Usada</p><p class="text-2xl font-black text-white" id="rx9070-vram">--</p></div>
          <div><p class="text-xs text-zinc-500">Temp Core</p><p class="text-2xl font-black text-white" id="rx9070-temp">--</p></div>
          <div><p class="text-xs text-zinc-500">Power</p><p class="text-2xl font-black text-white" id="rx9070-power">--</p></div>
          <div><p class="text-xs text-zinc-500">Estado</p><p class="text-2xl font-black text-emerald-400" id="rx9070-status">--</p></div>
        </div>
      </div>
      <div class="rounded-2xl border border-zinc-800 bg-zinc-950 p-6">
        <h2 class="text-xl font-bold text-purple-400">RX7900XT</h2>
        <p class="text-sm text-zinc-500">192.168.1.60 · 20GB VRAM</p>
        <div class="mt-4 grid grid-cols-2 gap-4">
          <div><p class="text-xs text-zinc-500">VRAM Usada</p><p class="text-2xl font-black text-white" id="rx7900xt-vram">--</p></div>
          <div><p class="text-xs text-zinc-500">Temp Core</p><p class="text-2xl font-black text-white" id="rx7900xt-temp">--</p></div>
          <div><p class="text-xs text-zinc-500">Power</p><p class="text-2xl font-black text-white" id="rx7900xt-power">--</p></div>
          <div><p class="text-xs text-zinc-500">Estado</p><p class="text-2xl font-black text-red-400" id="rx7900xt-status">--</p></div>
        </div>
      </div>
    </section>

    <section class="rounded-2xl border border-zinc-800 bg-zinc-950 p-6">
      <h2 class="text-xl font-bold text-cyan-400 mb-4">GPU Metrics API</h2>
      <pre class="text-xs text-zinc-400 font-mono" id="gpu-raw">Esperando datos...</pre>
    </section>
  </section>
</Layout>

<script>
  function setText(id, value) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  }

  function pickNumber(node, keys) {
    for (const key of keys) {
      const value = node?.[key];
      if (typeof value === "number" && Number.isFinite(value)) return value;
    }
    return null;
  }

  async function refreshGPUs() {
    try {
      const res = await fetch("/api/status.json", { cache: "no-store" });
      if (!res.ok) throw new Error(`status_${res.status}`);

      const data = await res.json();
      const gpu = Array.isArray(data.gpu) ? data.gpu : [];
      const nodes = [
        { prefix: "rx9070", name: "RX9070" },
        { prefix: "rx7900xt", name: "RX7900XT" },
      ];

      for (const node of nodes) {
        const g = gpu.find((item) => item.node === node.name);
        if (!g) {
          setText(`${node.prefix}-vram`, "--");
          setText(`${node.prefix}-temp`, "--");
          setText(`${node.prefix}-power`, "--");
          setText(`${node.prefix}-status`, "OFFLINE");
          document.getElementById(`${node.prefix}-status`).className = "text-2xl font-black text-red-400";
          continue;
        }

        const vramUsed = pickNumber(g, ["vram_used_gib", "vram_used"]);
        const vramTotal = pickNumber(g, ["vram_total_gib", "vram_total"]);
        const temp = pickNumber(g, ["temp", "temp_celsius", "gpu_temp"]);
        const power = pickNumber(g, ["power", "power_watts"]);

        setText(`${node.prefix}-vram`, `${vramUsed ?? 0} / ${vramTotal ?? 0} GiB`);
        setText(`${node.prefix}-temp`, temp === null ? "--" : `${temp.toFixed(0)} °C`);
        setText(`${node.prefix}-power`, power === null ? "--" : `${power.toFixed(0)} W`);
        setText(`${node.prefix}-status`, (vramTotal ?? 0) > 0 ? "ONLINE" : "OFFLINE");
        document.getElementById(`${node.prefix}-status`).className = `text-2xl font-black ${(vramTotal ?? 0) > 0 ? "text-emerald-400" : "text-red-400"}`;
      }

      setText("gpu-source", "LIVE");
      setText("gpu-updated", `última actualización: ${new Date().toISOString().slice(11, 19)} UTC`);
      setText("gpu-summary", `GPU nodes: ${gpu.length}`);
      document.getElementById("gpu-raw").textContent = JSON.stringify(gpu, null, 2);
    } catch {
      setText("gpu-source", "OFFLINE");
      setText("gpu-updated", "última actualización: error de lectura");
      setText("gpu-summary", "GPU nodes: --");
      const raw = document.getElementById("gpu-raw");
      if (raw) raw.textContent = "No se pudo leer /api/status.json";
    }
  }
  refreshGPUs();
  setInterval(refreshGPUs, 10000);
</script>
