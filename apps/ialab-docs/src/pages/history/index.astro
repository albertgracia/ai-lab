---

<Layout title="Historia del Laboratorio · AI-LAB">

<section class="space-y-14">

  <!-- Header -->
  <header class="rounded-3xl border border-cyan-500/30 bg-gradient-to-br from-zinc-900 via-zinc-950 to-black p-10 shadow-2xl shadow-cyan-950/20">
    <p class="text-sm uppercase tracking-[0.35em] text-cyan-400">AI-LAB · Historia</p>
    <h1 class="mt-5 text-5xl font-black text-white md:text-6xl">Historia del Laboratorio</h1>
    <p class="mt-4 max-w-4xl text-lg leading-8 text-zinc-300">
      Cronología de la evolución del AI-LAB. No es un changelog ni un log de Git.
      Es la historia técnica documentada: cómo empezó, qué grandes fases se completaron,
      qué arquitectura fue apareciendo y qué proyectos nacieron.
    </p>
  </header>

  <!-- Evolución del AI-LAB -->
  <section class="rounded-2xl border border-zinc-800 bg-zinc-900 p-8">
    <h2 class="text-3xl font-black text-white">Evolución del AI-LAB</h2>
    <p class="mt-2 text-zinc-400">Línea cronológica simplificada de la evolución del ecosistema.</p>

    <div class="mt-8 relative">
      <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-zinc-700"></div>

      <div class="space-y-0 relative">
        {
          fases.map((f, i) => (
            <div class="flex items-start gap-6 relative">
              <div class="flex flex-col items-center z-10">
                <div class="w-16 h-16 rounded-full flex items-center justify-center text-lg font-bold border-2"
                  class:list={[f.num <= 7 ? "bg-green-500/20 border-green-500 text-green-400" : f.num === 8 ? "bg-yellow-500/20 border-yellow-500 text-yellow-400" : "bg-zinc-500/20 border-zinc-500 text-zinc-400"]}>
                  {f.num}
                </div>
                {i < fases.length - 1 && <div class="w-0.5 h-8 bg-zinc-700"></div>}
              </div>
              <div class="flex-1 pb-8">
                <p class="text-lg font-bold text-white">{f.name}</p>
                <p class="text-sm text-zinc-400">{f.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Grandes Hitos -->
  <section class="rounded-2xl border border-zinc-800 bg-zinc-900 p-8">
    <h2 class="text-3xl font-black text-white">Grandes Hitos</h2>
    <p class="mt-2 text-zinc-400">Los hitos más importantes que marcaron la evolución del AI-LAB.</p>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {
        grandesHitos.map((h) => (
          <div class="rounded-xl border border-zinc-800 bg-zinc-950 p-5 hover:border-cyan-500/30 transition">
            <div class="flex items-center justify-between mb-2">
              <p class="text-sm font-semibold text-cyan-400">{h.name}</p>
              <span class="text-xs font-bold text-green-400">{h.status}</span>
            </div>
            <p class="font-mono text-xs text-zinc-500">{h.checkpoint}</p>
            <p class="mt-2 text-sm text-zinc-400">{h.summary}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Timeline completa -->
  <section class="rounded-2xl border border-zinc-800 bg-zinc-900 p-8">
    <h2 class="text-3xl font-black text-white">Línea Temporal</h2>
    <p class="mt-2 text-zinc-400">Todos los checkpoints del AI-LAB organizados por año y mes.</p>

    <div class="mt-8 space-y-12">
      {
        years.map((year) => (
          <div>
            <h3 class="text-4xl font-black text-cyan-400 mb-2">{year}</h3>
            <div class="border-t border-zinc-700 mb-8"></div>

            {
              milestonesByYear[year].map((monthGroup) => (
                <div class="mb-10">
                  <h4 class="text-sm uppercase tracking-[0.25em] text-zinc-500 mb-4">{monthGroup.month}</h4>

                  <div class="relative ml-4">
                    <div class="absolute left-[7px] top-3 bottom-3 w-0.5 bg-zinc-800"></div>

                    <div class="space-y-6">
                      {
                        monthGroup.entries.map((entry) => (
                          <div class="relative pl-8">
                            <div class="absolute left-0 top-[10px] w-3.5 h-3.5 rounded-full border-2"
                              class:list={[entry.status === "PASS" ? "bg-green-900 border-green-400" : "bg-yellow-900 border-yellow-400"]}>
                            </div>

                            <div class="rounded-xl border p-5" class:list={[phaseColors[entry.type] || "border-zinc-800 bg-zinc-950"]}>
                              <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                                <div>
                                  <span class="font-mono text-xs" class:list={[typeColors[entry.type] || "text-zinc-400"]}>
                                    {entry.tag}
                                  </span>
                                  <h5 class="text-lg font-bold text-white mt-0.5">{entry.title}</h5>
                                </div>
                                <div class="flex items-center gap-3">
                                  <span class={`text-xs font-bold px-2 py-0.5 rounded ${entry.status === "PASS" ? "text-green-400 bg-green-500/10" : "text-yellow-400 bg-yellow-500/10"}`}>
                                    {entry.status}
                                  </span>
                                  <span class="text-xs" class:list={[typeColors[entry.type] || "text-zinc-500"]}>
                                    {entry.type}
                                  </span>
                                </div>
                              </div>

                              <p class="text-sm text-zinc-400">{entry.summary}</p>

                              {
                                entry.reports && entry.reports.length > 0 && (
                                  <div class="mt-3 flex gap-3">
                                    {entry.reports.map((r) => (
                                      <a href={`/${r}`} class="text-xs text-cyan-400 hover:text-cyan-300 underline underline-offset-2">
                                        {r.replace(/^reports\//, "").replace(/\.md$/, "")}
                                      </a>
                                    ))}
                                    <a href={`https://github.com/albertgracia/ai-lab/releases/tag/${entry.tag}`} class="text-xs text-zinc-500 hover:text-zinc-300 underline underline-offset-2">
                                      tag
                                    </a>
                                  </div>
                                )
                              }

                              {
                                !entry.reports && (
                                  <div class="mt-3">
                                    <a href={`https://github.com/albertgracia/ai-lab/releases/tag/${entry.tag}`} class="text-xs text-zinc-500 hover:text-zinc-300 underline underline-offset-2">
                                      ver tag →
                                    </a>
                                  </div>
                                )
                              }
                            </div>
                          </div>
                        ))
                      }
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        ))
      }
    </div>
  </section>

  <!-- Fases -->
  <section class="rounded-2xl border border-zinc-800 bg-zinc-900 p-8">
    <h2 class="text-3xl font-black text-white">Arquitectura por Fases</h2>
    <p class="mt-2 text-zinc-400">Cómo evolucionó la arquitectura del AI-LAB fase por fase.</p>

    <div class="mt-8 space-y-0">
      {
        fases.map((f, i) => (
          <div class="flex items-start gap-6">
            <div class="flex flex-col items-center">
              <div class="w-12 h-12 rounded-full flex items-center justify-center font-bold border-2 shrink-0"
                class:list={[f.num <= 7 ? "bg-green-500/20 border-green-500 text-green-400" : f.num === 8 ? "bg-yellow-500/20 border-yellow-500 text-yellow-400" : "bg-zinc-500/20 border-zinc-500 text-zinc-400"]}>
                {f.num}
              </div>
              {i < fases.length - 1 && <div class="w-0.5 h-10 bg-zinc-700"></div>}
            </div>
            <div class="flex-1 pb-6">
              <p class="font-bold text-white">{f.name}</p>
              <p class="text-sm text-zinc-400">{f.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Navigation -->
  <div class="flex justify-center gap-4">
    <a href="/status" class="rounded-xl border border-zinc-700 px-6 py-3 font-bold text-zinc-200 hover:border-cyan-400 hover:text-cyan-400">
      ← Centro de Mando
    </a>
    <a href="/architecture" class="rounded-xl border border-zinc-700 px-6 py-3 font-bold text-zinc-200 hover:border-cyan-400 hover:text-cyan-400">
      Arquitectura →
    </a>
  </div>

</section>

</Layout>
