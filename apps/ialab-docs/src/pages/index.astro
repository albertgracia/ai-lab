---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 4);

const details = [
  {
    title: "Hermes Enterprise Core",
    text: "Capa de governance declarativo del runtime. 6 componentes (SOUL, Capability, Operator, Hook, MCP, Dynamic Governance), 185 tests, endpoint GET /hermes/status.",
    href: "/docs/hermes/",
  },
  {
    title: "AnythingLLM Enterprise",
    text: "Knowledge Base multi-workspace con RAG validado: 1304 vectores, embedder multilingual e5-small, 7 workspaces activos, chunk size 800, overlap 100.",
    href: "/docs/architecture/anythingllm-enterprise/",
  },
  {
    title: "Marketplace Digital Twin",
    text: "Rioja Marketplace replicado como Digital Twin observacional. Go + Fiber v2, Next.js 15, indexado en GitNexus con MCP read-only.",
    href: "/docs/architecture/marketplace-digital-twin/",
  },
  {
    title: "GitNexus Code Intelligence",
    text: "Cognición estructural del codebase: 20K+ símbolos, 32K+ relaciones, 300 execution flows, impact analysis, detect_changes, GITNEXUS-FIRST policy.",
    href: "/docs/codebase-structural-cognition/",
  },
];

const highlights = [
  {
    title: "AI Infrastructure",
    text: "Diseño y operación de una plataforma IA local con router OpenAI-compatible, GPUs remotas, observabilidad Prometheus/Grafana y 100+ métricas ailab_*.",
  },
  {
    title: "Systems Engineering",
    text: "Administración Linux/Windows, systemd, LVM, servicios persistentes, Docker Compose, Traefik, troubleshooting y operación de infraestructura real.",
  },
  {
    title: "Secure Self-Hosting",
    text: "Publicación segura con Cloudflare Access, Tunnel y Zero Trust. Separación público/privado con build filter y redirects edge.",
  },
];
---

<Layout title="Albert · AI Infrastructure Engineer · AI-LAB">

<section class="space-y-16">

  <section class="rounded-3xl border border-cyan-500/30 bg-gradient-to-br from-zinc-900 via-zinc-950 to-black p-10 shadow-2xl shadow-cyan-950/20">
    <p class="text-sm uppercase tracking-[0.35em] text-cyan-400">
      Técnico de Sistemas · AI Infrastructure Builder
    </p>

    <h1 class="mt-6 max-w-5xl text-5xl font-black leading-tight text-white md:text-7xl">
      Diseño, despliego y documento infraestructuras IT modernas.
    </h1>

    <p class="mt-6 max-w-4xl text-xl leading-relaxed text-zinc-300">
      Especializado en sistemas, redes, contenedores, automatización, self-hosting seguro,
      plataformas locales de inteligencia artificial, observabilidad real y gobernanza de runtime.
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/architecture" class="rounded-xl bg-cyan-400 px-6 py-3 font-bold text-zinc-950 hover:bg-cyan-300">
        Ver arquitectura
      </a>

      <a href="https://metricas.labrazahome.com" class="rounded-xl border border-zinc-700 px-6 py-3 font-bold text-zinc-200 hover:border-cyan-400 hover:text-cyan-400">
        Estado vivo del LAB
      </a>

      <a href="/docs/" class="rounded-xl border border-zinc-700 px-6 py-3 font-bold text-zinc-200 hover:border-cyan-400 hover:text-cyan-400">
        Documentación
      </a>
    </div>
  </section>

  <section class="grid gap-6 md:grid-cols-3">
    {
      highlights.map((item) => (
        <div class="rounded-2xl border border-zinc-800 bg-zinc-900 p-6">
          <h2 class="text-2xl font-bold text-cyan-400">{item.title}</h2>
          <p class="mt-4 leading-relaxed text-zinc-400">{item.text}</p>
        </div>
      ))
    }
  </section>

  <section class="rounded-2xl border border-zinc-800 bg-zinc-900 p-8">
    <p class="text-sm uppercase tracking-[0.3em] text-cyan-400">
      Ecosistema actual
    </p>

    <h2 class="mt-4 text-4xl font-black text-white">
      AI-LAB · Plataforma IA con gobernanza enterprise
    </h2>

    <p class="mt-5 max-w-5xl text-lg leading-relaxed text-zinc-300">
      AI-LAB ha evolucionado de un homelab de experimentación a una plataforma de ingeniería con
      runtime evidence-bound, gobernanza declarativa (Hermes Enterprise), knowledge base RAG,
      marketplace digital twin y separación público/privado de documentación.
    </p>

    <div class="mt-8 grid gap-4 md:grid-cols-4">
      <div class="rounded-xl bg-zinc-950 p-5">
        <p class="text-sm text-zinc-500">Hermes Core</p>
        <p class="mt-2 font-semibold text-white">185 tests PASS</p>
        <p class="text-zinc-400">6 componentes enterprise</p>
      </div>

      <div class="rounded-xl bg-zinc-950 p-5">
        <p class="text-sm text-zinc-500">Knowledge Base</p>
        <p class="mt-2 font-semibold text-white">1304 vectores</p>
        <p class="text-zinc-400">7 workspaces RAG</p>
      </div>

      <div class="rounded-xl bg-zinc-950 p-5">
        <p class="text-sm text-zinc-500">Runtime</p>
        <p class="mt-2 font-semibold text-white">3 modelos activos</p>
        <p class="text-zinc-400">SLO + Adaptive Concurrency</p>
      </div>

      <div class="rounded-xl bg-zinc-950 p-5">
        <p class="text-sm text-zinc-500">Observabilidad</p>
        <p class="mt-2 font-semibold text-white">100+ métricas</p>
        <p class="text-zinc-400">19 alertas activas</p>
      </div>
    </div>
  </section>

  <section>
    <div class="flex items-end justify-between gap-6">
      <div>
        <p class="text-sm uppercase tracking-[0.3em] text-cyan-400">
          Componentes del ecosistema
        </p>

        <h2 class="mt-3 text-4xl font-black text-white">
          Plataforma actual
        </h2>
      </div>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {
        details.map((item) => (
          <a href={item.href} class="block rounded-2xl border border-zinc-800 bg-zinc-900 p-6 transition hover:border-cyan-500 hover:bg-zinc-900/80">
            <h3 class="text-2xl font-bold text-cyan-400">{item.title}</h3>
            <p class="mt-4 leading-relaxed text-zinc-400">{item.text}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="rounded-2xl border border-zinc-800 bg-zinc-900 p-8">
    <div class="flex items-end justify-between gap-6">
      <div>
        <p class="text-sm uppercase tracking-[0.3em] text-cyan-400">
          Blog técnico
        </p>

        <h2 class="mt-3 text-4xl font-black text-white">
          Últimas entradas
        </h2>
      </div>

      <a href="/blog/" class="hidden rounded-xl border border-zinc-700 px-5 py-3 font-bold text-zinc-200 hover:border-cyan-400 hover:text-cyan-400 md:block">
        Ver todas
      </a>
    </div>

    <div class="mt-8 grid gap-4">
      {posts.map((post) => (
        <a href={`/blog/${post.id.replace(/\.md$/, "")}`} class="block rounded-xl border border-zinc-800 bg-zinc-950 p-5 transition hover:border-cyan-500">
          <p class="text-xs text-zinc-500">{post.data.date}</p>
          <h3 class="mt-1 text-xl font-semibold text-white">{post.data.title}</h3>
          <p class="mt-1 text-sm text-zinc-400">{post.data.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="grid gap-6 md:grid-cols-3">
      <a href="/architecture" class="block rounded-2xl border border-zinc-800 bg-zinc-900 p-6 transition hover:border-cyan-500 hover:bg-zinc-900/80">
        <h2 class="text-2xl font-bold text-cyan-400">Arquitectura</h2>
        <p class="mt-4 leading-relaxed text-zinc-400">Mapa completo del ecosistema: capas, servicios, flujo de peticiones y topología de red.</p>
      </a>

      <a href="/status/" class="block rounded-2xl border border-zinc-800 bg-zinc-900 p-6 transition hover:border-cyan-500 hover:bg-zinc-900/80">
        <h2 class="text-2xl font-bold text-cyan-400">Estado del Laboratorio</h2>
        <p class="mt-4 leading-relaxed text-zinc-400">Fotografía documental del estado actual del ecosistema AI-LAB: componentes, builds y última actualización.</p>
      </a>

      <a href="/docs/roadmap/" class="block rounded-2xl border border-zinc-800 bg-zinc-900 p-6 transition hover:border-cyan-500 hover:bg-zinc-900/80">
        <h2 class="text-2xl font-bold text-cyan-400">Roadmap</h2>
        <p class="mt-4 leading-relaxed text-zinc-400">Estado actual de implementación, próximas fases y prioridades del laboratorio.</p>
      </a>

      <a href="https://metricas.labrazahome.com" class="block rounded-2xl border border-zinc-800 bg-zinc-900 p-6 transition hover:border-cyan-500 hover:bg-zinc-900/80">
        <h2 class="text-2xl font-bold text-cyan-400">Estado Vivo</h2>
        <p class="mt-4 leading-relaxed text-zinc-400">Métricas en tiempo real, dashboards GPU, SLO health y telemetría histórica.</p>
      </a>
  </section>

  <section class="rounded-2xl border border-zinc-800 bg-zinc-900 p-8">
    <p class="text-sm uppercase tracking-[0.3em] text-cyan-400">
      Perfil profesional
    </p>

    <h2 class="mt-4 text-4xl font-black text-white">
      Técnico de Sistemas con enfoque en plataformas modernas
    </h2>

    <p class="mt-5 max-w-5xl text-lg leading-relaxed text-zinc-300">
      Combino administración de sistemas, redes, automatización y documentación técnica con
      integración de herramientas actuales de IA. Construyo entornos mantenibles, observables
      y seguros, priorizando operación real, troubleshooting y claridad arquitectónica.
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      <div>
        <p class="text-sm uppercase tracking-wide text-cyan-400">Operación</p>
        <p class="mt-2 text-zinc-400">Servicios persistentes, runbooks, systemd, SLO enforcement y adaptive concurrency.</p>
      </div>

      <div>
        <p class="text-sm uppercase tracking-wide text-cyan-400">Infraestructura</p>
        <p class="mt-2 text-zinc-400">Docker, Traefik, Cloudflare, DNS, storage LVM, reverse proxy y GPU compute.</p>
      </div>

      <div>
        <p class="text-sm uppercase tracking-wide text-cyan-400">IA aplicada</p>
        <p class="mt-2 text-zinc-400">LLMs locales, Qdrant, RAG, evidence-bound runtime, governance declarativo y observabilidad.</p>
      </div>
    </div>
  </section>

</section>

</Layout>
