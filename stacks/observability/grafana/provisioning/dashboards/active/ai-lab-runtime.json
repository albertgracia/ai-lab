    {
      "type": "timeseries",
      "title": "Drift Graph",
      "datasource": "Prometheus",
      "description": "abs(RHS can\u00f3nico - RHS cross-check). >20 = warning",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
