{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ailab-router": {
      "name": "AI-LAB Router",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.1.30:8083/v1"
      },
      "models": {
        "auto": {
          "name": "auto"
        },
        "fast": {
          "name": "fast"
        },
        "coding": {
          "name": "coding"
        },
        "reasoning": {
          "name": "reasoning"
        }
      }
    }
  },
  "agent": {
    "general": {
      "tools": {
        "read": false,
        "edit": false,
        "glob": false,
        "grep": false,
        "list": false,
        "bash": false,
        "task": false,
        "skill": false,
        "question": false,
        "webfetch": false,
        "websearch": false,
        "repo_clone": false,
        "repo_overview": false,
        "lsp": false
      },
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    }
  },
  "disabled_providers": ["lm"]
}